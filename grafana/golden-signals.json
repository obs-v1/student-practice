{
  "uid": "bankobs-golden",
  "title": "bankobs — Golden Signals",
  "tags": [
    "bankobs",
    "golden-signals"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values({__name__=~\"http_requests_total|http_server_requests_total\", namespace=\"bankobs\"}, app)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latency — request duration (p50 / p95 / p99)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate({__name__=~\"http_request_duration_seconds_bucket|http_server_request_duration_seconds_bucket\", namespace=\"bankobs\", app=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"http_request_duration_seconds_bucket|http_server_request_duration_seconds_bucket\", namespace=\"bankobs\", app=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=~\"http_request_duration_seconds_bucket|http_server_request_duration_seconds_bucket\", namespace=\"bankobs\", app=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Traffic — requests / sec (by service)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate({__name__=~\"http_requests_total|http_server_requests_total\", namespace=\"bankobs\", app=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors — non-2xx share  (click ▸ for which service)",
      "description": "Aggregate error ratio. Use the panel link (top-left ▸) to open the per-service Errors breakdown.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "links": [
        {
          "title": "▸ Which service? Open Errors by service",
          "url": "/d/bankobs-errors?${service:queryparam}&${datasource:queryparam}&${__url_time_range}",
          "targetBlank": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "links": [
            {
              "title": "Errors by service →",
              "url": "/d/bankobs-errors?${service:queryparam}&${datasource:queryparam}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"http_requests_total|http_server_requests_total\", namespace=\"bankobs\", app=~\"$service\", status=~\"[45]xx\"}[$__rate_interval])) / clamp_min(sum(rate({__name__=~\"http_requests_total|http_server_requests_total\", namespace=\"bankobs\", app=~\"$service\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Saturation — CPU (cores, by service)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate(process_cpu_seconds_total{namespace=\"bankobs\", app=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Saturation — resident memory (by service)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (process_resident_memory_bytes{namespace=\"bankobs\", app=~\"$service\"})",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Services DOWN (up == 0)",
      "description": "Non-zero = an availability incident, e.g. 'make fault NAME=app-crash' (CrashLoop -> up==0). Note: a service SCALED to 0 leaves service-discovery entirely, so it drops off the chart rather than showing 0.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{namespace=\"bankobs\"} == 0) or vector(0)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Availability — up per service (0 = down / crashlooping)",
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 6,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=\"bankobs\", app=~\"$service\"}",
          "legendFormat": "{{app}}"
        }
      ]
    }
  ]
}